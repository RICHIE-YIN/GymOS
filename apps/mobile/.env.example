# =============================================================================
# GymOS Mobile App — Environment Variables (Expo)
# =============================================================================
# Copy this file to .env and update the values for your environment.
#   cp apps/mobile/.env.example apps/mobile/.env
#
# All variables MUST be prefixed with EXPO_PUBLIC_ to be accessible
# in the React Native JavaScript bundle at build time.
#
# Do NOT commit your .env file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
# Base URL of the GymOS REST API.
#
# Local development (simulator / emulator):
#   EXPO_PUBLIC_API_URL=http://localhost:3000
#
# Local development (physical device):
#   Replace localhost with your machine's local IP address.
#   Find it with: ipconfig (Windows) or ifconfig / ip a (macOS/Linux)
#   EXPO_PUBLIC_API_URL=http://192.168.1.100:3000
#
# Production:
#   EXPO_PUBLIC_API_URL=https://api.gymos.io
EXPO_PUBLIC_API_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# App metadata
# -----------------------------------------------------------------------------
EXPO_PUBLIC_APP_NAME=GymOS
EXPO_PUBLIC_APP_VERSION=1.0.0
