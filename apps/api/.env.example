# =============================================================================
# GymOS API — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
#   cp apps/api/.env.example apps/api/.env
#
# Lines starting with # are comments and are ignored.
# Do NOT commit your .env file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Append ?sslmode=require for production connections.
DATABASE_URL=postgresql://user:password@localhost:5432/gymos

# -----------------------------------------------------------------------------
# JWT — Authentication Tokens
# -----------------------------------------------------------------------------
# Secret key used to sign and verify access tokens.
# In production, use a long random string:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string-in-production

# How long access tokens remain valid (e.g. 7d, 24h, 3600s).
JWT_EXPIRES_IN=7d

# Secret key used to sign and verify refresh tokens.
# Must be different from JWT_SECRET.
JWT_REFRESH_SECRET=change-this-to-a-different-long-random-string-in-production

# How long refresh tokens remain valid.
JWT_REFRESH_EXPIRES_IN=30d

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# Port the Express server listens on.
PORT=3000

# Runtime environment: development | production | test
NODE_ENV=development

# Allowed CORS origin in production mode (ignored in development — all origins allowed).
CORS_ORIGIN=http://localhost:3001

# Number of bcrypt hash rounds. Higher = more secure but slower.
# 12 is a good default; consider 14 for high-security environments.
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# AI (optional — AI coach features will be disabled if not set)
# -----------------------------------------------------------------------------
# Your OpenAI API key. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# AI provider identifier (currently only "openai" is supported).
AI_PROVIDER=openai

# OpenAI model to use for completions. gpt-4o-mini is cost-effective for coaching.
AI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# File Storage — AWS S3 (optional — progress photos will be disabled if not set)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# -----------------------------------------------------------------------------
# Stripe — Payments (optional — payment features will be disabled if not set)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# Set to "true" or "false" to enable/disable features at runtime.
FEATURE_AI_COACH=true
FEATURE_PAYMENTS=false
FEATURE_PROGRESS_PHOTOS=true
