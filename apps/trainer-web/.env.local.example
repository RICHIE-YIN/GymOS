# =============================================================================
# GymOS Trainer Web — Environment Variables (Next.js)
# =============================================================================
# Copy this file to .env.local and update the values for your environment.
#   cp apps/trainer-web/.env.local.example apps/trainer-web/.env.local
#
# Variables prefixed with NEXT_PUBLIC_ are embedded into the browser bundle
# at build time and are visible to the client.
#
# Do NOT commit your .env.local file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
# Base URL of the GymOS REST API.
#
# Local development:
#   NEXT_PUBLIC_API_URL=http://localhost:3000
#
# Production:
#   NEXT_PUBLIC_API_URL=https://api.gymos.io
NEXT_PUBLIC_API_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# App metadata
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=GymOS Trainer
